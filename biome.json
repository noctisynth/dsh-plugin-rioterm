{
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!.changes/*.md", "!CHANGELOG.md"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true },
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": {
    "formatter": { "quoteStyle": "single" },
    "jsxRuntime": "reactClassic"
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**", "src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/preferences/**",
                      "**/host/**",
                      "**/pages/**",
                      "**/plugin/**",
                      "**/rio/**",
                      "**/session/**",
                      "**/terminal/**",
                      "**/client.ts",
                      "@deepseek-ai/**",
                      "rioterm"
                    ],
                    "message": "Shared UI primitives must not know about terminal pages, sessions or the host."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/host/**",
                      "**/plugin/**",
                      "**/session/**",
                      "**/client.ts",
                      "@deepseek-ai/**",
                      "rioterm"
                    ],
                    "message": "Pages receive a TerminalSession and navigation callbacks; use the screen adapter for Rio."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/session/**", "src/terminal/**", "src/preferences/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/host/**",
                      "**/components/**",
                      "**/lib/cn*",
                      "**/pages/**",
                      "**/plugin/**",
                      "**/rio/**",
                      "**/session/**",
                      "**/client.ts",
                      "@deepseek-ai/**",
                      "react",
                      "react/**",
                      "rioterm"
                    ],
                    "message": "Session, preference model and contract code must run without UI, Rio or the DSH runtime."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/rio/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/host/**",
                      "**/components/**",
                      "**/lib/cn*",
                      "**/plugin/**",
                      "**/pages/**",
                      "**/session/**",
                      "**/client.ts",
                      "@deepseek-ai/**",
                      "react",
                      "react/**"
                    ],
                    "message": "The Rio screen consumes terminal frames, not sidebar state or PTY handles."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
