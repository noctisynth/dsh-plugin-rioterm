{
  "name": "dsh-plugin-rioterm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.1",
  "description": "Interactive Rio WebAssembly terminal for DeepSeek Harness",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "check": "biome check . && pnpm run typecheck",
    "format": "biome format --write .",
    "build": "tsdown && tsc -p tsconfig.host.json && node scripts/copy-wasm.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "class-variance-authority": "~0.7.1",
    "clsx": "^2.1.1",
    "jiti": "2.7.0",
    "postcss": "8.5.25",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "rioterm": "0.1.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsdown": "0.23.7",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "7.0.2"
  }
}
