{
  "name": "dsh-plugin-rioterm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.1",
  "description": "Interactive Rio WebAssembly terminal for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "terminal",
    "rio",
    "webassembly"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noctisynth/dsh-plugin-rioterm.git"
  },
  "homepage": "https://github.com/noctisynth/dsh-plugin-rioterm#readme",
  "bugs": {
    "url": "https://github.com/noctisynth/dsh-plugin-rioterm/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs/licenses",
    "README.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "check": "biome check . && pnpm run typecheck",
    "format": "biome format --write .",
    "build": "tsdown && tsc -p tsconfig.host.json && node scripts/copy-wasm.mjs",
    "prepack": "pnpm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "class-variance-authority": "~0.7.1",
    "clsx": "^2.1.1",
    "jiti": "2.7.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "rioterm": "0.1.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsdown": "0.23.7",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
